### GET Health Check
# Query the Terminus health monitoring endpoint to check service and database status
GET http://localhost:3000/health
Accept: application/json

### Register a New User
POST http://localhost:3000/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123",
  "passwordConfirm": "password123",
  "firstName": "John",
  "lastName": "Doe"
}

### Login with the New User
POST http://localhost:3000/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}

### Get Current User Profile (Requires JWT token from Login)
GET http://localhost:3000/users/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJlbWFpbCI6InRlc3RAZXhhbXBsZS5jb20iLCJzdWIiOiI1OTdlYTgzNi02NjQ4LTQzYzgtYWYwOC1iMWZmMjcyOGI3OGEiLCJyb2xlIjoiYWRtaW4iLCJpYXQiOjE3ODEwMjY1NDksImV4cCI6MTc4MTAzMDE0OX0.xOKHJt9svhpuSoHANJg3V1mvcg0kS_CrqbgZjGD_1j4

### Update Current User Profile
PATCH http://localhost:3000/users/me
Authorization: Bearer <replace-with-access-token>
Content-Type: application/json

{
  "firstName": "Jonathan",
  "phoneNumber": "123-456-7890"
}

### Update Password
PATCH http://localhost:3000/users/me/password
Authorization: Bearer <replace-with-access-token>
Content-Type: application/json

{
  "oldPassword": "password123",
  "newPassword": "newpassword123"
}

### Forgot Password (request reset token)
POST http://localhost:3000/auth/forgot-password
Content-Type: application/json

{
  "email": "test@example.com"
}

### Reset Password (using token from forgot password response)
POST http://localhost:3000/auth/reset-password
Content-Type: application/json

{
  "token": "<replace-with-development-token>",
  "newPassword": "password123"
}

### Get All Rooms
# Retrieves all available rooms sorted by room number
# Optional query parameters: checkIn, checkOut (YYYY-MM-DD)
# GET http://localhost:3000/rooms?checkIn=2026-06-01&checkOut=2026-06-05&status=available
GET http://localhost:3000/rooms/9593fd0e-75a3-425b-a58c-f588cc3cb30a
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJlbWFpbCI6InRlc3RAZXhhbXBsZS5jb20iLCJzdWIiOiI1OTdlYTgzNi02NjQ4LTQzYzgtYWYwOC1iMWZmMjcyOGI3OGEiLCJyb2xlIjoiYWRtaW4iLCJpYXQiOjE3ODEwODk3OTcsImV4cCI6MTc4MTA5MzM5N30.KOhOOOtXMEbWm3OmSxsZh8AHBJvsVLWmtX1SRqmUxIc
Accept: application/json

### Create a New Room (Admin only)
POST http://localhost:3000/rooms
Authorization: Bearer <replace-with-admin-access-token>
Content-Type: application/json

{
  "roomNumber": "501",
  "type": "apartment",
  "basePricePerNight": 600.00,
  "status": "available"
}

### Update a Room (Admin/Staff only)
PATCH http://localhost:3000/rooms/<replace-with-room-uuid>
Authorization: Bearer <replace-with-staff-access-token>
Content-Type: application/json

{
  "basePricePerNight": 650.00,
  "status": "maintenance"
}

### Delete a Room (Admin only, safe soft-delete)
DELETE http://localhost:3000/rooms/2bf594ef-560f-4082-b5f1-cee73c0fe145
Authorization: Bearer <replace-with-admin-access-token>

### Create a Booking
POST http://localhost:3000/bookings
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJlbWFpbCI6InRlc3RAZXhhbXBsZS5jb20iLCJzdWIiOiI1OTdlYTgzNi02NjQ4LTQzYzgtYWYwOC1iMWZmMjcyOGI3OGEiLCJyb2xlIjoiYWRtaW4iLCJpYXQiOjE3ODEwODk3OTcsImV4cCI6MTc4MTA5MzM5N30.KOhOOOtXMEbWm3OmSxsZh8AHBJvsVLWmtX1SRqmUxIc
Content-Type: application/json

{
  "roomId": "9593fd0e-75a3-425b-a58c-f588cc3cb30a",
  "checkInDate": "2026-06-13",
  "checkOutDate": "2026-06-14"
}

### Get My Reservations
GET http://localhost:3000/bookings/my-reservations
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJlbWFpbCI6InRlc3RAZXhhbXBsZS5jb20iLCJzdWIiOiI1OTdlYTgzNi02NjQ4LTQzYzgtYWYwOC1iMWZmMjcyOGI3OGEiLCJyb2xlIjoiYWRtaW4iLCJpYXQiOjE3ODExMDY1NzAsImV4cCI6MTc4MTExMDE3MH0.P1qptqJeB9X1NQ5kI7hhGH2xfk5kemFBvLGEMLFGcHA
Accept: application/json

### Stripe Webhook (Do not use request.http, use Stripe CLI)
# Run the following in terminal to test webhooks locally:
# stripe listen --forward-to localhost:3000/payments/webhook
# 
# POST http://localhost:3000/payments/webhook

### --- ADMIN & STAFF ENDPOINTS --- ###

### Get All Users (Admin/Staff)
GET http://localhost:3000/users
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJlbWFpbCI6InRlc3RAZXhhbXBsZS5jb20iLCJzdWIiOiI1OTdlYTgzNi02NjQ4LTQzYzgtYWYwOC1iMWZmMjcyOGI3OGEiLCJyb2xlIjoiYWRtaW4iLCJpYXQiOjE3ODA5NDg5NzMsImV4cCI6MTc4MDk1MjU3M30.DZPwBOlrY6-GFXO0P_b21DavdKV1QQzJCGwwA-hO5KA
Accept: application/json

### Get Single User (Admin/Staff)
GET http://localhost:3000/users/<replace-with-user-uuid>
Authorization: Bearer <replace-with-admin-or-staff-token>
Accept: application/json

### Update User Role (Admin only)
PATCH http://localhost:3000/users/<replace-with-user-uuid>/role
Authorization: Bearer <replace-with-admin-token>
Content-Type: application/json

{
  "role": "staff"
}

### Delete User (Admin only)
DELETE http://localhost:3000/users/<replace-with-user-uuid>
Authorization: Bearer <replace-with-admin-token>

### Get All Bookings (Admin/Staff)
GET http://localhost:3000/bookings
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJlbWFpbCI6InRlc3RAZXhhbXBsZS5jb20iLCJzdWIiOiI1OTdlYTgzNi02NjQ4LTQzYzgtYWYwOC1iMWZmMjcyOGI3OGEiLCJyb2xlIjoiYWRtaW4iLCJpYXQiOjE3ODEwODk3OTcsImV4cCI6MTc4MTA5MzM5N30.KOhOOOtXMEbWm3OmSxsZh8AHBJvsVLWmtX1SRqmUxIc
Accept: application/json

### Get Single Booking (Admin/Staff)
GET http://localhost:3000/bookings/<replace-with-booking-uuid>
Authorization: Bearer <replace-with-admin-or-staff-token>
Accept: application/json

### Update Booking Status (Admin/Staff)
PATCH http://localhost:3000/bookings/<replace-with-booking-uuid>/status
Authorization: Bearer <replace-with-admin-or-staff-token>
Content-Type: application/json

{
  "status": "checked-in"
}

### Get Admin Dashboard Stats (Admin only)
GET http://localhost:3000/admin/dashboard-stats
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJlbWFpbCI6InRlc3RAZXhhbXBsZS5jb20iLCJzdWIiOiI1OTdlYTgzNi02NjQ4LTQzYzgtYWYwOC1iMWZmMjcyOGI3OGEiLCJyb2xlIjoiYWRtaW4iLCJpYXQiOjE3ODA5NDg5NzMsImV4cCI6MTc4MDk1MjU3M30.DZPwBOlrY6-GFXO0P_b21DavdKV1QQzJCGwwA-hO5KA
Accept: application/json
