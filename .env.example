# ==============================================================================
# BERESIDE - Local Development Environment Variables
# Copy this file to '.env' and modify credentials as needed.
# ==============================================================================

# Application Port
PORT=3000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=bereside_admin
DB_PASSWORD=password
DB_NAME=bereside_booking_db

# Fully-resolved Database URL (for Prisma, TypeORM, Knex, etc.)
DATABASE_URL=postgresql://bereside_admin:password@localhost:5432/bereside_booking_db?schema=public
